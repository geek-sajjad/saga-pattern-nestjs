{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/orchestrator",
  "sourceRoot": "apps/orchestrator/src",
  "compilerOptions": {
    "builder": "tsc",
    "webpack": false,
    "deleteOutDir": false
  },
  "projects": {
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": { "tsConfigPath": "libs/common/tsconfig.lib.json" }
    },
    "orchestrator": {
      "type": "application",
      "root": "apps/orchestrator",
      "entryFile": "apps/orchestrator/src/main",
      "sourceRoot": "apps/orchestrator/src",
      "compilerOptions": { "tsConfigPath": "apps/orchestrator/tsconfig.app.json" }
    },
    "ocean-carrier": {
      "type": "application",
      "root": "apps/ocean-carrier",
      "entryFile": "apps/ocean-carrier/src/main",
      "sourceRoot": "apps/ocean-carrier/src",
      "compilerOptions": { "tsConfigPath": "apps/ocean-carrier/tsconfig.app.json" }
    },
    "customs": {
      "type": "application",
      "root": "apps/customs",
      "entryFile": "apps/customs/src/main",
      "sourceRoot": "apps/customs/src",
      "compilerOptions": { "tsConfigPath": "apps/customs/tsconfig.app.json" }
    },
    "trucking": {
      "type": "application",
      "root": "apps/trucking",
      "entryFile": "apps/trucking/src/main",
      "sourceRoot": "apps/trucking/src",
      "compilerOptions": { "tsConfigPath": "apps/trucking/tsconfig.app.json" }
    },
    "warehouse": {
      "type": "application",
      "root": "apps/warehouse",
      "entryFile": "apps/warehouse/src/main",
      "sourceRoot": "apps/warehouse/src",
      "compilerOptions": { "tsConfigPath": "apps/warehouse/tsconfig.app.json" }
    },
    "billing": {
      "type": "application",
      "root": "apps/billing",
      "entryFile": "apps/billing/src/main",
      "sourceRoot": "apps/billing/src",
      "compilerOptions": { "tsConfigPath": "apps/billing/tsconfig.app.json" }
    },
    "bpmn-engine": {
      "type": "application",
      "root": "apps/bpmn-engine",
      "entryFile": "apps/bpmn-engine/src/main",
      "sourceRoot": "apps/bpmn-engine/src",
      "compilerOptions": { "tsConfigPath": "apps/bpmn-engine/tsconfig.app.json" }
    }
  }
}
