<?xml version="1.0" encoding="UTF-8"?>
<!--
  customs-clearance, release 2026.2 (deployed as v2).
  What changed since 2026.1:
   - the receive task "Wait for customs release" became an EVENT-BASED GATEWAY that races three events:
     the goods are released, customs orders a physical inspection, or 30s pass (chase the broker, wait again);
   - a failed inspection ends with the error CARGO_SEIZED. Nothing in this process catches it, so it
     travels up to the call activity in import-shipment, which compensates every booking.
  Node ids that mean the same thing are kept (Task_Declare, Task_Release, Timer_Chase), so the version diff
  in the cockpit shows only what really changed.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:mini="https://example.com/mini-bpmn"
                  id="Definitions_customs-clearance" targetNamespace="https://example.com/mini-bpmn">
  <bpmn:message id="Msg_Cleared" name="CustomsCleared" mini:correlationKey="${shipmentRef}" />
  <bpmn:message id="Msg_Inspection" name="InspectionOrdered" mini:correlationKey="${shipmentRef}" />
  <bpmn:error id="Error_Seized" name="Cargo seized" errorCode="CARGO_SEIZED" />
  <bpmn:process id="customs-clearance" name="Customs clearance" isExecutable="true" mini:versionTag="2026.2">
    <bpmn:startEvent id="Start_Customs" name="Goods need clearing" />
    <bpmn:serviceTask id="Task_Declare" name="Submit import declaration" mini:handler="customs.declare" />
    <bpmn:exclusiveGateway id="Gw_Merge" />
    <bpmn:eventBasedGateway id="Gw_Decision" name="Customs decision?" />
    <bpmn:intermediateCatchEvent id="Event_Cleared" name="Goods released">
      <bpmn:messageEventDefinition id="MsgDef_Cleared" messageRef="Msg_Cleared" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Timer_Chase" name="30s without answer">
      <bpmn:timerEventDefinition id="TimerDef_Chase"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_Inspection" name="Inspection ordered">
      <bpmn:messageEventDefinition id="MsgDef_Inspection" messageRef="Msg_Inspection" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_Chase" name="Chase the customs broker" mini:handler="customs.chaseBroker" />
    <bpmn:userTask id="Task_Inspect" name="Inspect the cargo" mini:formFields="passed:boolean,findings:string" />
    <bpmn:serviceTask id="Task_RecordInspection" name="Record inspection result" mini:handler="customs.recordInspection" />
    <bpmn:exclusiveGateway id="Gw_Passed" name="Passed?" default="Flow_Failed" />
    <bpmn:serviceTask id="Task_Release" name="Record customs release" mini:handler="customs.recordRelease" />
    <bpmn:endEvent id="End_Cleared" name="Goods cleared" />
    <bpmn:endEvent id="End_Seized" name="Cargo seized">
      <bpmn:errorEventDefinition id="ErrDef_Seized" errorRef="Error_Seized" />
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Customs" targetRef="Task_Declare" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Declare" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gw_Merge" targetRef="Gw_Decision" />
    <bpmn:sequenceFlow id="Flow_ToCleared" sourceRef="Gw_Decision" targetRef="Event_Cleared" />
    <bpmn:sequenceFlow id="Flow_ToTimer" sourceRef="Gw_Decision" targetRef="Timer_Chase" />
    <bpmn:sequenceFlow id="Flow_ToInspection" sourceRef="Gw_Decision" targetRef="Event_Inspection" />
    <bpmn:sequenceFlow id="Flow_Released" sourceRef="Event_Cleared" targetRef="Task_Release" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Release" targetRef="End_Cleared" />
    <bpmn:sequenceFlow id="Flow_Chase" sourceRef="Timer_Chase" targetRef="Task_Chase" />
    <bpmn:sequenceFlow id="Flow_WaitAgain" name="wait again" sourceRef="Task_Chase" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="Flow_Inspect" sourceRef="Event_Inspection" targetRef="Task_Inspect" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Inspect" targetRef="Task_RecordInspection" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_RecordInspection" targetRef="Gw_Passed" />
    <bpmn:sequenceFlow id="Flow_Passed" name="yes" sourceRef="Gw_Passed" targetRef="Task_Release">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${inspection.passed === true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Failed" name="no" sourceRef="Gw_Passed" targetRef="End_Seized" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_customs-clearance">
    <bpmndi:BPMNPlane id="Plane_customs-clearance" bpmnElement="customs-clearance">
      <bpmndi:BPMNShape id="Start_Customs_di" bpmnElement="Start_Customs"><dc:Bounds x="152" y="202" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Declare_di" bpmnElement="Task_Declare"><dc:Bounds x="220" y="180" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Merge_di" bpmnElement="Gw_Merge" isMarkerVisible="true"><dc:Bounds x="360" y="195" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Decision_di" bpmnElement="Gw_Decision"><dc:Bounds x="440" y="195" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Cleared_di" bpmnElement="Event_Cleared"><dc:Bounds x="532" y="202" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Release_di" bpmnElement="Task_Release"><dc:Bounds x="620" y="180" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Cleared_di" bpmnElement="End_Cleared"><dc:Bounds x="782" y="202" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_Chase_di" bpmnElement="Timer_Chase"><dc:Bounds x="532" y="82" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Chase_di" bpmnElement="Task_Chase"><dc:Bounds x="620" y="60" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Inspection_di" bpmnElement="Event_Inspection"><dc:Bounds x="532" y="322" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Inspect_di" bpmnElement="Task_Inspect"><dc:Bounds x="620" y="300" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RecordInspection_di" bpmnElement="Task_RecordInspection"><dc:Bounds x="770" y="300" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Passed_di" bpmnElement="Gw_Passed" isMarkerVisible="true"><dc:Bounds x="915" y="315" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Seized_di" bpmnElement="End_Seized"><dc:Bounds x="1022" y="322" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="188" y="220" /><di:waypoint x="220" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="320" y="220" /><di:waypoint x="360" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="410" y="220" /><di:waypoint x="440" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToCleared_di" bpmnElement="Flow_ToCleared"><di:waypoint x="490" y="220" /><di:waypoint x="532" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToTimer_di" bpmnElement="Flow_ToTimer"><di:waypoint x="465" y="195" /><di:waypoint x="465" y="100" /><di:waypoint x="532" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToInspection_di" bpmnElement="Flow_ToInspection"><di:waypoint x="465" y="245" /><di:waypoint x="465" y="340" /><di:waypoint x="532" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Released_di" bpmnElement="Flow_Released"><di:waypoint x="568" y="220" /><di:waypoint x="620" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="720" y="220" /><di:waypoint x="782" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Chase_di" bpmnElement="Flow_Chase"><di:waypoint x="568" y="100" /><di:waypoint x="620" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_WaitAgain_di" bpmnElement="Flow_WaitAgain"><di:waypoint x="670" y="60" /><di:waypoint x="670" y="30" /><di:waypoint x="385" y="30" /><di:waypoint x="385" y="195" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Inspect_di" bpmnElement="Flow_Inspect"><di:waypoint x="568" y="340" /><di:waypoint x="620" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="720" y="340" /><di:waypoint x="770" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="870" y="340" /><di:waypoint x="915" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Passed_di" bpmnElement="Flow_Passed"><di:waypoint x="940" y="315" /><di:waypoint x="940" y="280" /><di:waypoint x="670" y="280" /><di:waypoint x="670" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Failed_di" bpmnElement="Flow_Failed"><di:waypoint x="965" y="340" /><di:waypoint x="1022" y="340" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
