<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:mini="https://example.com/mini-bpmn"
                  id="Definitions_quote-approval" targetNamespace="https://example.com/mini-bpmn">
  <bpmn:process id="quote-approval" name="Quote approval" isExecutable="true">
    <bpmn:startEvent id="Start_Quote" name="Quote requested">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Calculate" name="Calculate quote" mini:handler="quote.calculate">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Big" name="Over EUR 10,000?" default="Flow_Small">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Big</bpmn:outgoing>
      <bpmn:outgoing>Flow_Small</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Approve" name="Manager approves quote" mini:formFields="approved:boolean,comment:string">
      <bpmn:incoming>Flow_Big</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Approved" name="Approved?" default="Flow_Rejected">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Reject" name="Email rejection to customer" mini:handler="customer.sendRejection">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Rejected" name="Quote rejected">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_Merge">
      <bpmn:incoming>Flow_Small</bpmn:incoming>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gw_Fork">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_Notify" name="Notify sales" mini:handler="sales.notify">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Sign" name="Customer signs contract" mini:formFields="signedBy:string">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gw_Join">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:intermediateCatchEvent id="Timer_CoolingOff" name="Cooling-off period (15s)">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_CoolingOff"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15S</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Active" name="Contract active">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Quote" targetRef="Task_Calculate" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Calculate" targetRef="Gw_Big" />
    <bpmn:sequenceFlow id="Flow_Big" name="yes" sourceRef="Gw_Big" targetRef="Task_Approve">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${quote.amount &gt; 10000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Small" name="no" sourceRef="Gw_Big" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Approve" targetRef="Gw_Approved" />
    <bpmn:sequenceFlow id="Flow_Approved" name="yes" sourceRef="Gw_Approved" targetRef="Gw_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved === true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejected" name="no" sourceRef="Gw_Approved" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Reject" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gw_Merge" targetRef="Gw_Fork" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gw_Fork" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gw_Fork" targetRef="Task_Sign" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Notify" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Sign" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gw_Join" targetRef="Timer_CoolingOff" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Timer_CoolingOff" targetRef="End_Active" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_quote-approval">
    <bpmndi:BPMNPlane id="Plane_quote-approval" bpmnElement="quote-approval">
      <bpmndi:BPMNShape id="Start_Quote_di" bpmnElement="Start_Quote">
        <dc:Bounds x="152" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Calculate_di" bpmnElement="Task_Calculate">
        <dc:Bounds x="240" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Big_di" bpmnElement="Gw_Big">
        <dc:Bounds x="395" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Approve_di" bpmnElement="Task_Approve">
        <dc:Bounds x="490" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Approved_di" bpmnElement="Gw_Approved">
        <dc:Bounds x="645" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reject_di" bpmnElement="Task_Reject">
        <dc:Bounds x="740" y="20" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejected_di" bpmnElement="End_Rejected">
        <dc:Bounds x="902" y="42" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Merge_di" bpmnElement="Gw_Merge">
        <dc:Bounds x="765" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Fork_di" bpmnElement="Gw_Fork">
        <dc:Bounds x="855" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Notify_di" bpmnElement="Task_Notify">
        <dc:Bounds x="950" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Sign_di" bpmnElement="Task_Sign">
        <dc:Bounds x="950" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Join_di" bpmnElement="Gw_Join">
        <dc:Bounds x="1095" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_CoolingOff_di" bpmnElement="Timer_CoolingOff">
        <dc:Bounds x="1192" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Active_di" bpmnElement="End_Active">
        <dc:Bounds x="1282" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="260" />
        <di:waypoint x="240" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="260" />
        <di:waypoint x="395" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Big_di" bpmnElement="Flow_Big">
        <di:waypoint x="420" y="235" />
        <di:waypoint x="420" y="160" />
        <di:waypoint x="490" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Small_di" bpmnElement="Flow_Small">
        <di:waypoint x="445" y="260" />
        <di:waypoint x="765" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="590" y="160" />
        <di:waypoint x="645" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved">
        <di:waypoint x="695" y="160" />
        <di:waypoint x="790" y="160" />
        <di:waypoint x="790" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Rejected_di" bpmnElement="Flow_Rejected">
        <di:waypoint x="670" y="135" />
        <di:waypoint x="670" y="60" />
        <di:waypoint x="740" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="840" y="60" />
        <di:waypoint x="902" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="815" y="260" />
        <di:waypoint x="855" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="880" y="235" />
        <di:waypoint x="880" y="180" />
        <di:waypoint x="950" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="880" y="285" />
        <di:waypoint x="880" y="340" />
        <di:waypoint x="950" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1050" y="180" />
        <di:waypoint x="1120" y="180" />
        <di:waypoint x="1120" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1050" y="340" />
        <di:waypoint x="1120" y="340" />
        <di:waypoint x="1120" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1145" y="260" />
        <di:waypoint x="1192" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1228" y="260" />
        <di:waypoint x="1282" y="260" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
