<?xml version="1.0" encoding="UTF-8"?>
<!--
  customs-clearance, release 2026.1 (deployed as v1).
  Submit the declaration, then wait for customs to release the goods. If customs stays silent,
  a NON-interrupting timer chases the broker while the receive task keeps waiting.
  Release 2026.2 (customs-clearance.v2.bpmn) replaces the receive task with an event-based gateway
  and adds physical inspections; see the README for migrating running v1 instances to it.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:mini="https://example.com/mini-bpmn"
                  id="Definitions_customs-clearance" targetNamespace="https://example.com/mini-bpmn">
  <bpmn:message id="Msg_Cleared" name="CustomsCleared" mini:correlationKey="${shipmentRef}" />
  <bpmn:process id="customs-clearance" name="Customs clearance" isExecutable="true" mini:versionTag="2026.1">
    <bpmn:startEvent id="Start_Customs" name="Goods need clearing" />
    <bpmn:serviceTask id="Task_Declare" name="Submit import declaration" mini:handler="customs.declare" />
    <bpmn:receiveTask id="Wait_Release" name="Wait for customs release" messageRef="Msg_Cleared" />
    <bpmn:boundaryEvent id="Timer_Chase" name="30s without answer" attachedToRef="Wait_Release" cancelActivity="false">
      <bpmn:timerEventDefinition id="TimerDef_Chase"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_Chase" name="Chase the customs broker" mini:handler="customs.chaseBroker" />
    <bpmn:endEvent id="End_Chased" name="Broker chased" />
    <bpmn:serviceTask id="Task_Release" name="Record customs release" mini:handler="customs.recordRelease" />
    <bpmn:endEvent id="End_Cleared" name="Goods cleared" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Customs" targetRef="Task_Declare" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Declare" targetRef="Wait_Release" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Wait_Release" targetRef="Task_Release" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Release" targetRef="End_Cleared" />
    <bpmn:sequenceFlow id="Flow_Chase" sourceRef="Timer_Chase" targetRef="Task_Chase" />
    <bpmn:sequenceFlow id="Flow_Chased" sourceRef="Task_Chase" targetRef="End_Chased" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_customs-clearance">
    <bpmndi:BPMNPlane id="Plane_customs-clearance" bpmnElement="customs-clearance">
      <bpmndi:BPMNShape id="Start_Customs_di" bpmnElement="Start_Customs"><dc:Bounds x="152" y="202" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Declare_di" bpmnElement="Task_Declare"><dc:Bounds x="240" y="180" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Wait_Release_di" bpmnElement="Wait_Release"><dc:Bounds x="400" y="180" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_Chase_di" bpmnElement="Timer_Chase"><dc:Bounds x="432" y="242" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Chase_di" bpmnElement="Task_Chase"><dc:Bounds x="400" y="320" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Chased_di" bpmnElement="End_Chased"><dc:Bounds x="562" y="342" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Release_di" bpmnElement="Task_Release"><dc:Bounds x="560" y="180" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Cleared_di" bpmnElement="End_Cleared"><dc:Bounds x="722" y="202" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="188" y="220" /><di:waypoint x="240" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="340" y="220" /><di:waypoint x="400" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="500" y="220" /><di:waypoint x="560" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="660" y="220" /><di:waypoint x="722" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Chase_di" bpmnElement="Flow_Chase"><di:waypoint x="450" y="278" /><di:waypoint x="450" y="320" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Chased_di" bpmnElement="Flow_Chased"><di:waypoint x="500" y="360" /><di:waypoint x="562" y="360" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
